rules_version = '2';

// KaamMitra Firebase Storage rules
// documents/{uid}/license.jpg , documents/{uid}/selfie.jpg , ...
// - आफ्नो uid फोल्डरमा मात्र लेख्न/मेट्न पाउने
// - filename allowlist भएको मात्र (path-traversal र मनपरी नाम रोक्न)
// - image (jpeg/png/webp) वा PDF मात्र, खाली नभएको, < 5MB
// - signed-in जो कोहीले पढ्न पाउने (एडमिनले verify गर्न, app मा देखाउन)

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'bikashbhandari1825@gmail.com';
    }

    function isValidDoc() {
      return request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches(
             'image/jpeg|image/png|image/webp|application/pdf');
    }

    match /documents/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && fileName.matches(
             '(license|selfie|certificate|citizenship_front|citizenship_back|document|id|driving_license|vehicle_registration)(_[0-9]+)?[.](jpg|jpeg|png|webp|pdf)')
        && isValidDoc();
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // कामको पोर्टफोलियो तस्बिरहरू — आफ्नै uid फोल्डरमा image मात्र
    match /portfolio/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.auth.uid == uid
        && request.resource.size > 0
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/jpeg|image/png|image/webp');
      allow delete: if isSignedIn() && request.auth.uid == uid;
    }

    // In-app auto-update — release APK हरू। `open_filex`/`http` ले plain
    // (unauthenticated) GET बाट सिधै download गर्ने भएकोले public read;
    // upload भने owner-मात्र (Admin Dashboard को "App update" बटन, वा
    // Firebase Console बाट सिधै)।
    match /releases/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size > 0
        && request.resource.size < 300 * 1024 * 1024
        && fileName.matches('[a-zA-Z0-9_.-]+[.]apk');
    }

    // बाँकी सबै बन्द
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
