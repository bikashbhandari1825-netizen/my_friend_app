rules_version = '2';

// KaamMitra Firebase Storage rules.
// नोट: यो repo मा पहिले यो फाइल नै थिएन (firebase.json ले "storage.rules"
// रेफर गरे पनि) — deploy नभएसम्म Firebase ले डिफल्ट (सधैँ deny) rules
// लगाउँछ, वा Console बाट म्यानुअली सेट गरिएको जुनसुकै rule चलिरहेको हुन्छ,
// जुन यो repo बाट ट्र्याक हुँदैन। यो फाइलले नै अब स्रोत-अफ-ट्रुथ हो।

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'bikashbhandari1825@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── documents/{uid}/... ─────────────────────────────────
    // Worker KYC कागजात (citizenship/selfie/license/certificate) —
    // services/document_service.dart::uploadDocument। लेख्ने आफ्नै मात्र;
    // पढ्ने worker आफैं + admin verification tab (owner_dashboard_screen.dart)
    // मात्र — यो सरकारी परिचयपत्र/अनुहारको फोटो हो, कुनै पनि अर्को signed-in
    // user (customer वा अर्को worker) ले हेर्न नपाओस्। पहिले यहाँ जानाजानी
    // `isSignedIn()` (जुनसुकै signed-in user) राखिएको थियो — माथिकै comment ले
    // नै भन्थ्यो "worker आफैं + admin", तर rule ले त्योभन्दा धेरै फराकिलो
    // पहुँच दिइरहेको थियो (Play Store release अघिको security audit मा भेटिएको)।
    // Hardening: हरेक अपलोडमा आकार (≤ ८MB) र प्रकार (फोटो/PDF) सीमा — भण्डारण
    // बिल दुरुपयोग र खतरनाक फाइल (HTML/SVG/APK) रोक्न। delete सधैँ मिल्छ।
    function safeUpload() {
      return request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif|gif)|application/pdf');
    }
    match /documents/{uid}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) || isAdmin()) && safeUpload();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── portfolio/{uid}/... ─────────────────────────────────
    // Worker ले देखाउने कामको तस्बिर — employer हरूले worker profile मा
    // हेर्ने भएकोले सार्वजनिक-पढ्न (signed-in जो कोहीलाई) मिल्ने, लेख्ने
    // आफ्नै मात्र।
    match /portfolio/{uid}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(uid) || isAdmin()) && safeUpload();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── chats/{requestId}/media/... ─────────────────────────
    // Chat भित्रको फोटो/भिडियो/भ्वाइस — services/chat_media_service.dart।
    // पहिले यहाँ Firestore कै (अब fix भइसकेको) पुरानो permissive
    // `chats/{requestId}` rule सँगै जानाजानी मिलाइएको थियो — अब त्यहाँ
    // participant-मात्र भइसकेकोले यहाँ पनि उस्तै: booking को employer/
    // worker (वा admin) बाहेक कसैले पनि requestId अनुमान गरेर तेस्रो
    // पक्षको चैट फोटो/भिडियो सिधै list/read गर्न नपाओस्।
    function isChatMediaParticipant(requestId) {
      let r = firestore.get(/databases/(default)/documents/serviceRequests/$(requestId)).data;
      return r.employerUid == request.auth.uid || r.workerUid == request.auth.uid;
    }
    // Salon chat — `salon_chats/{id}.participants` मा आफू भए। (पहिले जाँचिन्छ ताकि
    // serviceRequests doc नभएको salon chat id मा त्यो get() error नदेओस्।)
    function isSalonChatMedia(requestId) {
      return firestore.exists(/databases/(default)/documents/salon_chats/$(requestId))
        && request.auth.uid in firestore.get(/databases/(default)/documents/salon_chats/$(requestId)).data.participants;
    }
    match /chats/{requestId}/media/{fileName} {
      allow read, delete: if isSignedIn()
        && (isSalonChatMedia(requestId) || isChatMediaParticipant(requestId) || isAdmin());
      // आकार सीमा (≤ २५MB) — HTML/script जस्ता प्रकार रोक्न image/audio/video मात्र।
      allow create, update: if isSignedIn()
        && (isSalonChatMedia(requestId) || isChatMediaParticipant(requestId) || isAdmin())
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('(image|audio|video)/.*');
    }
    // माथिकै फोल्डर list गर्न (job_actions.dart::_deleteChatMedia — completion/
    // cancellation मा सबै media file सफा गर्न) छुट्टै `list` अनुमति चाहिन्छ।
    match /chats/{requestId}/media {
      allow list: if isSignedIn()
        && (isSalonChatMedia(requestId) || isChatMediaParticipant(requestId) || isAdmin());
    }

    // ── hotel_photos/{uid}/{hotelId}/... ───────────────────
    // Hotel Registration — होटल-मालिकले गैलेरीबाट छानेर अपलोड गर्ने
    // property फोटो (hotel_registration_screen.dart)। portfolio/{uid}
    // कै उस्तै pattern: पढ्ने सबै signed-in (guest search/detail ले
    // देख्ने), लेख्ने आफ्नै (uid) मात्र।
    match /hotel_photos/{uid}/{hotelId}/{fileName} {
      allow read: if isSignedIn();
      allow create, update: if (isOwner(uid) || isAdmin()) && safeUpload();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── salon_photos/{uid}/{salonId}/... ───────────────────
    // Salon logo र barber/stylist फोटो — ग्राहकले browse मा देख्ने भएकोले
    // पढ्ने सबै signed-in, लेख्ने त्यही मालिक (uid) मात्र; फोटो मात्र, ५ MB सम्म।
    match /salon_photos/{uid}/{salonId}/{fileName} {
      allow read: if isSignedIn();
      allow write: if (isOwner(uid) || isAdmin())
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── hotel_documents/{uid}/{hotelId}/... ────────────────
    // Hotel Registration — KYC प्रमाण (business license/PAN-VAT) — यो
    // सार्वजनिक फोटो होइन, documents/{uid} कै उस्तै private pattern:
    // पढ्ने/लेख्ने मालिक + admin (hotel_verification_admin_screen.dart)
    // मात्र।
    match /hotel_documents/{uid}/{hotelId}/{fileName} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if (isOwner(uid) || isAdmin())
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // बाँकी सबै बन्द।
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
