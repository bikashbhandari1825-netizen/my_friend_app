rules_version = '2';

// KaamMitra Firestore security rules
// एडमिन = bikashbhandari1825@gmail.com (Google वा email/password बाट login)।
// फोन/Anonymous बाट login भएका साधारण युजरको token मा email हुँदैन → admin बन्न सक्दैनन्।

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'bikashbhandari1825@gmail.com';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Single Active Job Restriction ─────────────────────────
    // worker ले एकैचोटि एउटा मात्र सक्रिय काम राख्न पाउँछ — client-side
    // (job_actions.dart कै claimJobForWorker/transaction) ले नै मुख्य
    // गरी लागू गर्छ, तर यहाँ पनि backend/rules-level defense-in-depth
    // (client bypass गरेर सिधै Firestore लेख्न खोजे पनि रोकियोस्)।
    function activeJobStatuses() {
      return ['accepted', 'confirmed', 'in_progress'];
    }

    function workerFreeToClaim(workerUid, docId) {
      let u = get(/databases/$(database)/documents/users/$(workerUid)).data;
      return !('activeJobId' in u) || u.activeJobId == '' || u.activeJobId == docId;
    }

    // ── users ────────────────────────────────────────────────
    // signed-in युजरले profile पढ्न सक्छन् (chat/booking नाम देखाउन);
    // आफ्नै doc मात्र लेख्न पाउँछन्; एडमिनले जुनसुकै।
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) || isAdmin()
        // Single Active Job Restriction — employer ले worker कै counter-
        // offer accept गर्दा (acceptWorkerCounterOffer) त्यो worker को
        // `activeJobId` pointer पनि employer कै transaction भित्रै लेख्नु
        // पर्छ (worker त्यो क्षणमा अनलाइन नहुन सक्छ)। यहाँ त्यही एउटा
        // field मात्र (अरू कुनै होइन) बदलिइरहेको भए जुनसुकै signed-in
        // user लाई अनुमति — worst-case प्रभाव अर्को worker "व्यस्त"
        // देखिनु मात्र हो, कुनै संवेदनशील डेटा लेखिँदैन।
        || (isSignedIn() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['activeJobId']));
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── providers ────────────────────────────────────────────
    match /providers/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── pendingWorkers (verification queue) ──────────────────
    // नोट: पहिले `update` एडमिन-मात्र थियो — तर registration submit हुँदा
    // (worker_registration_page.dart) र पछि दस्तावेज़ resync हुँदा
    // (document_service.dart) worker आफैंले यही doc मा citizenship/selfie
    // URL लेख्नुपर्छ, admin ले होइन। त्यो लेखाइ अनुमति नभएकोले चुपचाप
    // (silent catch) असफल भइरहेको थियो — नतिजा: Storage मा फाइल पुगे पनि
    // admin dashboard मा तस्बिर कहिल्यै नदेखिने (URL field नै खाली रहने)।
    // यहाँ worker लाई आफ्नै doc मा दस्तावेज़-सम्बन्धी field मात्र (status,
    // नाम, मूल्य, आदि होइन) लेख्न दिइएको छ — त्यो बाहेक अरू सबै अझै admin-मात्र।
    match /pendingWorkers/{doc} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['citizenshipFrontUrl', 'citizenshipBackUrl',
                           'selfieUrl', 'certificateUrls', 'licenseUrl',
                           'documentUrl', 'documentName', 'documentsPending',
                           'documentsError']));
      allow delete: if isAdmin();
    }

    // ── registeredWorkers (public list) ─────────────────────
    // admin ले approve गर्दा doc बन्छ; worker ले आफ्नै listing row (uid == self)
    // मा live location वा identity re-point update गर्न पाउँछ।
    match /registeredWorkers/{doc} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && doc == request.auth.uid)
        || (isSignedIn() && request.resource.data.uid == request.auth.uid);
    }

    // ── phoneAccounts (phone → uid index, test login persistence) ──
    match /phoneAccounts/{key} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── serviceRequests (bookings / bids) ───────────────────
    // broadcast अनुरोध (status == 'broadcasting') कुनै पनि signed-in worker ले
    // पढ्न सक्छ; accept गर्दा आफूलाई workerUid राख्न वा rejectedBy मा थप्न पाउँछ।
    match /serviceRequests/{doc} {
      allow read: if isSignedIn() && (
        resource.data.employerUid == request.auth.uid
        || resource.data.workerUid == request.auth.uid
        || resource.data.status == 'broadcasting'
        || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.employerUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.employerUid == request.auth.uid
        || resource.data.workerUid == request.auth.uid
        || isAdmin()
        // कुनै worker ले broadcast job claim गर्दा वा decline गर्दा
        || (resource.data.status == 'broadcasting' && (
              request.resource.data.workerUid == request.auth.uid
              || request.resource.data.status == 'broadcasting')))
        // Single Active Job Restriction (backend/rules-level defense-in-
        // depth) — यो अनुरोध नयाँ-नयाँ सक्रिय (accepted/confirmed/
        // in_progress) हुँदै छ भने मात्र (पहिल्यैदेखि सक्रिय भइसकेको काम,
        // जस्तै worker को लगातार GPS position अपडेट वा completed/cancelled
        // मा बाहिरिने बेला होइन), त्यो worker सँग हाल अर्को साँच्चै सक्रिय
        // काम नभएको पक्का गर्ने।
        && (
          isAdmin()
          || !(request.resource.data.status in activeJobStatuses())
          || resource.data.status in activeJobStatuses()
          || !('workerUid' in request.resource.data)
          || request.resource.data.workerUid == ''
          || workerFreeToClaim(request.resource.data.workerUid, doc)
        );
      allow delete: if isAdmin();
    }

    // ── chats ───────────────────────────────────────────────
    // TODO: booking को पक्ष हो कि भनेर get() ले कस्न सकिन्छ।
    // parent doc — अहिले "seen/read" receipt (`readBy.{uid}`) राख्न मात्र
    // प्रयोग हुन्छ; message हरू भने subcollection मै छन्।
    match /chats/{requestId} {
      allow read, create, update: if isSignedIn();
      match /messages/{msg} {
        allow read, create, update, delete: if isSignedIn();
      }
    }

    // ── calls (WebRTC signaling: offer/answer/ICE) ──────────
    match /calls/{requestId} {
      allow read, create, update, delete: if isSignedIn();
      match /{sub}/{cand} {
        allow read, create, update, delete: if isSignedIn();
      }
    }

    // ── notifications (per user) ────────────────────────────
    // कुनै पनि signed-in user ले अर्को user लाई notification पठाउन सक्छ
    // (जस्तै: employer ले काम post गर्दा नजिकका worker लाई radar alert)।
    match /notifications/{doc} {
      allow read, update: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid is string;
      allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid)
        || isAdmin();
    }

    // ── adminNotifications ─────────────────────────────────
    match /adminNotifications/{doc} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── reports / supportMessages (user → admin) ───────────
    match /reports/{doc} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    match /supportMessages/{doc} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── reviews ────────────────────────────────────────────
    match /reviews/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── config (support number etc.) ──────────────────────
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // बाँकी सबै बन्द
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
