rules_version = '2';

// KaamMitra Firestore security rules
// एडमिन = bikashbhandari1825@gmail.com (Google वा email/password बाट login)।
// फोन/Anonymous बाट login भएका साधारण युजरको token मा email हुँदैन → admin बन्न सक्दैनन्।

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'bikashbhandari1825@gmail.com';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ── Single Active Job Restriction ─────────────────────────
    // worker ले एकैचोटि एउटा मात्र सक्रिय काम राख्न पाउँछ — client-side
    // (job_actions.dart कै claimJobForWorker/transaction) ले नै मुख्य
    // गरी लागू गर्छ, तर यहाँ पनि backend/rules-level defense-in-depth
    // (client bypass गरेर सिधै Firestore लेख्न खोजे पनि रोकियोस्)।
    function activeJobStatuses() {
      return ['accepted', 'confirmed', 'in_progress'];
    }

    function workerFreeToClaim(workerUid, docId) {
      let u = get(/databases/$(database)/documents/users/$(workerUid)).data;
      return !('activeJobId' in u) || u.activeJobId == '' || u.activeJobId == docId;
    }

    // ── users ────────────────────────────────────────────────
    // signed-in युजरले profile पढ्न सक्छन् (chat/booking नाम देखाउन);
    // आफ्नै doc मात्र लेख्न पाउँछन्; एडमिनले जुनसुकै।
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) || isAdmin()
        // Single Active Job Restriction — employer ले worker कै counter-
        // offer accept गर्दा (acceptWorkerCounterOffer) त्यो worker को
        // `activeJobId` pointer पनि employer कै transaction भित्रै लेख्नु
        // पर्छ (worker त्यो क्षणमा अनलाइन नहुन सक्छ)। यहाँ त्यही एउटा
        // field मात्र (अरू कुनै होइन) बदलिइरहेको भए जुनसुकै signed-in
        // user लाई अनुमति — worst-case प्रभाव अर्को worker "व्यस्त"
        // देखिनु मात्र हो, कुनै संवेदनशील डेटा लेखिँदैन।
        || (isSignedIn() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['activeJobId']));
      allow delete: if isOwner(uid) || isAdmin();
    }

    // ── providers ────────────────────────────────────────────
    match /providers/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── pendingWorkers (verification queue) ──────────────────
    // नोट: पहिले `update` एडमिन-मात्र थियो — तर registration submit हुँदा
    // (worker_registration_page.dart) र पछि दस्तावेज़ resync हुँदा
    // (document_service.dart) worker आफैंले यही doc मा citizenship/selfie
    // URL लेख्नुपर्छ, admin ले होइन। त्यो लेखाइ अनुमति नभएकोले चुपचाप
    // (silent catch) असफल भइरहेको थियो — नतिजा: Storage मा फाइल पुगे पनि
    // admin dashboard मा तस्बिर कहिल्यै नदेखिने (URL field नै खाली रहने)।
    // यहाँ worker लाई आफ्नै doc मा दस्तावेज़-सम्बन्धी field मात्र (status,
    // नाम, मूल्य, आदि होइन) लेख्न दिइएको छ — त्यो बाहेक अरू सबै अझै admin-मात्र।
    match /pendingWorkers/{doc} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.uid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['citizenshipFrontUrl', 'citizenshipBackUrl',
                           'selfieUrl', 'certificateUrls', 'licenseUrl',
                           'documentUrl', 'documentName', 'documentsPending',
                           'documentsError']));
      allow delete: if isAdmin();
    }

    // ── registeredWorkers (public list) ─────────────────────
    // admin ले approve गर्दा doc बन्छ; worker ले आफ्नै listing row (uid == self)
    // मा live location वा identity re-point update गर्न पाउँछ।
    match /registeredWorkers/{doc} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && doc == request.auth.uid)
        || (isSignedIn() && request.resource.data.uid == request.auth.uid);
    }

    // ── phoneAccounts (phone → uid index, test login persistence) ──
    match /phoneAccounts/{key} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ── serviceRequests (bookings / bids) ───────────────────
    // broadcast अनुरोध (status == 'broadcasting') कुनै पनि signed-in worker ले
    // पढ्न सक्छ; accept गर्दा आफूलाई workerUid राख्न वा rejectedBy मा थप्न पाउँछ।
    match /serviceRequests/{doc} {
      allow read: if isSignedIn() && (
        resource.data.employerUid == request.auth.uid
        || resource.data.workerUid == request.auth.uid
        || resource.data.status == 'broadcasting'
        || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.employerUid == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.employerUid == request.auth.uid
        || resource.data.workerUid == request.auth.uid
        || isAdmin()
        // कुनै worker ले broadcast job claim गर्दा वा decline गर्दा
        || (resource.data.status == 'broadcasting' && (
              request.resource.data.workerUid == request.auth.uid
              || request.resource.data.status == 'broadcasting')))
        // Single Active Job Restriction (backend/rules-level defense-in-
        // depth) — यो अनुरोध नयाँ-नयाँ सक्रिय (accepted/confirmed/
        // in_progress) हुँदै छ भने मात्र (पहिल्यैदेखि सक्रिय भइसकेको काम,
        // जस्तै worker को लगातार GPS position अपडेट वा completed/cancelled
        // मा बाहिरिने बेला होइन), त्यो worker सँग हाल अर्को साँच्चै सक्रिय
        // काम नभएको पक्का गर्ने।
        && (
          isAdmin()
          || !(request.resource.data.status in activeJobStatuses())
          || resource.data.status in activeJobStatuses()
          || !('workerUid' in request.resource.data)
          || request.resource.data.workerUid == ''
          || workerFreeToClaim(request.resource.data.workerUid, doc)
        );
      // employer वा assigned worker ले आफ्नै request cancel गर्दा
      // (deleteCancelledBooking, job_actions.dart) डिलिट गर्न पाउनुपर्छ —
      // पहिले admin-मात्र थियो, जसले गर्दा real user (non-admin) को
      // cancel ले चुपचाप (silent catch) असफल भई doc अनिश्चित कालसम्म
      // "ghost booking" भएर बसिरहन्थ्यो, अनि history मा नराम्रो cancelled
      // rows देखिन्थे।
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.employerUid == request.auth.uid)
        || (isSignedIn() && resource.data.workerUid == request.auth.uid);

      // ── rideOffers (Bike/Car ride-hailing मात्र) ────────────
      // inDrive-style simultaneous bidding: धेरै driver ले एकैचोटि आ-आफ्नै
      // भाडा प्रस्ताव यहाँ (आफ्नै uid को doc) लेख्छन् — parent doc कहिल्यै
      // छुँदैन (workerUid/status अझै खाली नै रहन्छ, driver-driver बीच race
      // हुनसक्दैन)। passenger (employer) ले तीमध्ये एउटा छान्दा मात्र
      // parent doc अपडेट हुन्छ (job_actions.dart::acceptRideOffer)।
      match /rideOffers/{offerId} {
        // पहिले जुनसुकै signed-in user ले (यो booking सँग कुनै सरोकार
        // नभए पनि) सबै driver को प्रतिस्पर्धी भाडा प्रस्ताव हेर्न सक्थे —
        // अब त्यो offer आफ्नै (driver) वा parent request कै employer
        // (यात्रु) वा admin मात्र।
        allow read: if isSignedIn() && (
          resource.data.workerUid == request.auth.uid
          || get(/databases/$(database)/documents/serviceRequests/$(doc))
               .data.employerUid == request.auth.uid
          || isAdmin());
        allow create: if isSignedIn()
          && request.resource.data.workerUid == request.auth.uid;
        allow update: if isSignedIn() && (
          resource.data.workerUid == request.auth.uid
          || get(/databases/$(database)/documents/serviceRequests/$(doc))
               .data.employerUid == request.auth.uid
          || isAdmin());
        allow delete: if isAdmin();
      }
    }

    // ── chats ───────────────────────────────────────────────
    // पहिले जुनसुकै signed-in user ले (requestId थाहा/अनुमान भए) अर्को
    // दुई व्यक्तिबीचको निजी कुराकानी नै पढ्न/मेट्न सक्थे — अब त्यही
    // booking का employer/worker (वा admin) मात्र। parent doc — "seen/
    // read" receipt (`readBy.{uid}`) राख्न मात्र प्रयोग हुन्छ; message
    // हरू भने subcollection मै छन्।
    function isChatParticipant(requestId) {
      let r = get(/databases/$(database)/documents/serviceRequests/$(requestId)).data;
      return r.employerUid == request.auth.uid || r.workerUid == request.auth.uid;
    }
    match /chats/{requestId} {
      allow read, create, update: if isSignedIn()
        && (isChatParticipant(requestId) || isAdmin());
      // deleteCancelledBooking (job_actions.dart) ले यो parent doc लाई
      // messages/serviceRequests सँगै एउटै batch मा डिलिट गर्छ — delete
      // यहाँ अनुमति नभए पूरै batch (serviceRequests समेत) atomically
      // असफल हुन्थ्यो। बुकिङ मेटिनुअघि नै हो भएकोले participant जाँच
      // अझै लागू गर्न मिल्छ।
      allow delete: if isSignedIn()
        && (isChatParticipant(requestId) || isAdmin());
      match /messages/{msg} {
        allow read, create, update, delete: if isSignedIn()
          && (isChatParticipant(requestId) || isAdmin());
      }
    }

    // ── calls (WebRTC signaling: offer/answer/ICE) ──────────
    // चैट कै उस्तै — अर्को दुई व्यक्तिको live call सिग्नलिङमा (ICE
    // candidate injection/मेटाउन) तेस्रो व्यक्तिले हस्तक्षेप गर्न
    // नपाओस् भनेर booking का participant मात्र।
    match /calls/{requestId} {
      allow read, create, update, delete: if isSignedIn()
        && (isChatParticipant(requestId) || isAdmin());
      match /{sub}/{cand} {
        allow read, create, update, delete: if isSignedIn()
          && (isChatParticipant(requestId) || isAdmin());
      }
    }

    // ── notifications (per user) ────────────────────────────
    // कुनै पनि signed-in user ले अर्को user लाई notification पठाउन सक्छ
    // (जस्तै: employer ले काम post गर्दा नजिकका worker लाई radar alert)।
    match /notifications/{doc} {
      allow read, update: if isSignedIn()
        && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid is string;
      allow delete: if (isSignedIn() && resource.data.uid == request.auth.uid)
        || isAdmin();
    }

    // ── adminNotifications ─────────────────────────────────
    match /adminNotifications/{doc} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── reports / supportMessages (user → admin) ───────────
    match /reports/{doc} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }
    match /supportMessages/{doc} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── cancellations (ride/job cancel reason — analytics-only log,
    // बुकिङ आफैं cancel हुँदा पूर्ण रूपमा मेटिन्छ, यो छुट्टै हल्का log हो) ──
    match /cancellations/{doc} {
      allow create: if isSignedIn();
      allow read, update, delete: if isAdmin();
    }

    // ── sosAlerts (emergency SOS button — admin/support ले पछि हेर्ने) ──
    match /sosAlerts/{doc} {
      allow create: if isSignedIn();
      allow read: if isSignedIn()
        && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ── reviews ────────────────────────────────────────────
    // पहिले जुनसुकै signed-in user ले `authorUid` जे पायो त्यही राखेर
    // (अरू कसैको नाममा समेत) फर्जी review लेख्न सक्थे — रेटिङ बढाउने/
    // प्रतिस्पर्धीलाई तल झार्ने दुरुपयोग हुन सक्थ्यो। अब authorUid
    // आफ्नै हुनैपर्छ, र जुन booking (`requestId`) को नाममा review
    // लेखिँदैछ त्यो साँच्चै आफूले नै employer भएर पूरा गरेको (completed)
    // काम नै हुनुपर्छ — worker को uid पनि मिल्नुपर्छ।
    match /reviews/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid
        && get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.requestId)).data.employerUid == request.auth.uid
        && get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.requestId)).data.workerUid == request.resource.data.targetUid
        && get(/databases/$(database)/documents/serviceRequests/$(request.resource.data.requestId)).data.status == 'completed';
      allow update, delete: if isAdmin();
    }

    // ── config (support number etc.) ──────────────────────
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // बाँकी सबै बन्द
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
